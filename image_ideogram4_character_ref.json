      "title": "Diptych caption — describe character ONCE in detail, reuse verbatim in both elements; set outfit hexes in both palettes",
      "properties": {
        "Node name for S&R": "CLIPTextEncode"
      },
      "widgets_values": [
        "{\n  \"high_level_description\": \"A two-panel diptych: two photographs of the exact same person wearing the identical outfit. She is DESCRIBE CHARACTER + OUTFIT IN DETAIL. Left panel: full-body studio reference photo, standing, plain gray background. Right panel: the very same person, same face, same hair, same outfit, DESCRIBE NEW SCENE / POSE / ACTION\",\n  \"style_description\": {\n    \"aesthetics\": \"clean, natural, true-to-life\",\n    \"lighting\": \"soft diffused daylight\",\n    \"photo\": \"full-body portrait\",\n    \"medium\": \"photograph\"\n  },\n  \"compositional_deconstruction\": {\n    \"background\": \"left half: plain light gray studio backdrop; right half: DESCRIBE NEW SCENE BACKGROUND\",\n    \"elements\": [\n      {\n        \"type\": \"obj\",\n        \"bbox\": [40, 140, 980, 360],\n        \"desc\": \"CHARACTER + OUTFIT, standing, studio reference\",\n        \"color_palette\": [\"#2A9D8F\", \"#D4A017\", \"#FFFFFF\", \"#1F3D2B\", \"#C0392B\"]\n      },\n      {\n        \"type\": \"obj\",\n        \"bbox\": [180, 560, 920, 940],\n        \"desc\": \"the exact same person: CHARACTER + OUTFIT, identical face and outfit, DOING THE NEW ACTION\",\n        \"color_palette\": [\"#2A9D8F\", \"#D4A017\", \"#FFFFFF\", \"#1F3D2B\", \"#C0392B\"]\n      }\n    ]\n  }\n}"
      ]
